      "task": "i2i",
      "file": "image/qwen_image_edit.json",
      "prompt": { "node": "9", "field": "prompt" },
      "image": { "node": "7", "field": "image" },
      "params": [
        { "key": "steps", "label": "步数", "type": "int", "default": 4, "node": "12", "field": "steps" },
        { "key": "cfg", "label": "CFG", "type": "float", "default": 1.0, "node": "12", "field": "cfg" },
        { "key": "seed", "label": "随机种子(0=随机)", "type": "int", "default": 0, "node": "12", "field": "seed" }
      ]
